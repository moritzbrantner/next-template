{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "typecheck", "test:unit"],
    "full": [
      "format:check",
      "lint",
      "typecheck",
      "build",
      "test:unit",
      "test:integration",
      "test:e2e",
      "storybook:check"
    ]
  },
  "requiredCapabilities": ["format:check", "lint", "typecheck", "build", "test:unit"],
  "optionalCapabilities": ["test:integration", "test:e2e", "storybook:check"],
  "capabilityCommands": {
    ".": {
      "format:check": ["bun", "run", "format:check"],
      "lint": ["bun", "run", "lint"],
      "typecheck": ["bun", "run", "typecheck"],
      "build": ["bun", "run", "build"],
      "test:unit": ["bun", "run", "test:unit"],
      "test:integration": ["bun", "run", "test:integration"],
      "test:e2e": ["bun", "run", "test:e2e"],
      "storybook:check": ["bun", "run", "test:storybook"]
    }
  }
}
